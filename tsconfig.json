{
  "compilerOptions": {
    "baseUrl": "./", // Base del proyecto (directorio raíz)
    "paths": {
      "@/*": ["./*"] // El alias # apunta a cualquier ruta desde el directorio raíz
    },
    "moduleResolution": "node",
    "target": "es2021",
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"] // Incluye todos los archivos .ts
}
